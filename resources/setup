#!/usr/bin/env bash
# Bootstrap script — run this on a fresh machine before anything else.
# Downloads the repo and runs the full install.
set -e

echo "[+] Updating system"
sudo apt update -y

echo "[+] Installing dependencies"
sudo apt install -y git stow curl fzf

DEV_DIR="$HOME/projects/dev"

echo "[+] Preparing workspace"
mkdir -p "$HOME/projects" "$HOME/lab" "$HOME/.dev-personal" "$HOME/work"

if [ ! -d "$DEV_DIR" ]; then
    git clone git@github.com:Flamur38/dev.git "$DEV_DIR"
else
    echo "[!] Repo already exists, pulling latest"
    git -C "$DEV_DIR" pull
fi

echo "[+] Installing packages"
cd "$DEV_DIR"
./run base-system

echo "[+] Stowing dotfiles"
./install

echo "[done] Restart your session to apply all changes"
