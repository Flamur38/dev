#!/usr/bin/env bash
set -e

log() { echo "[terminator] $1"; }

CFG_DIR="$HOME/.config/terminator"
CFG_FILE="$CFG_DIR/config"

log "Installing Terminator"
sudo apt update
sudo apt install -y terminator

mkdir -p "$CFG_DIR"

log "Writing Terminator config (default profile, Sublime/Juliana theme)"
cat > "$CFG_FILE" <<'EOF'
[global_config]
  profile = default
[keybindings]
[profiles]
  [[default]]
    allow_bold = False
    visible_bell = True
    icon_bell = False
    font = Hack 18
    show_titlebar = False
    use_system_font = False

    # Sublime Juliana-ish palette
    background_color = "#a4b1cd"
    foreground_color = "#101927"
    cursor_color = "#fac761"
    selection_color = "#3f4750"

    # 16-color palette (normal + bright)
    palette = "#303841:#ec5f66:#99c794:#fac761:#5c99d6:#c695c6:#5fb4b4:#d8dee9:#46525c:#c76b70:#99c794:#f9ae58:#95b2d6:#c695c6:#87c7c7:#ffffff"

[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0

[plugins]
EOF

log "Done. Restart Terminator to apply changes."
