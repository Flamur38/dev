[global_config]
[keybindings]
[profiles]
  [[default]]
    visible_bell = True
    icon_bell = False
    background_color = "#0f1319"
    foreground_color = "#d6dee8"
    cursor_fg_color = "#0f1319"
    cursor_bg_color = "#ffb020"
    cursor_color_default = False
    font = JetBrainsMono Nerd Font Medium 20
    show_titlebar = False
    scrollbar_position = hidden
    scrollback_lines = 50000
    bold_is_bright = True
    palette = "#1a1f27:#ff4d5e:#3dd68c:#ffb020:#3b9eff:#c77dff:#22d3ee:#d6dee8:#4b5563:#ff7a85:#6ee7b7:#ffd166:#7cc0ff:#dda8ff:#67e8f9:#f3f6fa"
    use_system_font = False
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
[plugins]

