[global_config]
[keybindings]
[profiles]
  [[default]]
    cursor_fg_color = "#000000"
    cursor_bg_color = "#fac761"
    cursor_color_default = False
    font = JetBrainsMono Nerd Font 20
    foreground_color = "#a6acb9"
    show_titlebar = False
    scrollbar_position = hidden
    scrollback_lines = 10000
    palette = "#1a1c1e:#ff6b6b:#6c9975:#e9ad0c:#5aafff:#7f7cb4:#bb8069:#b4b4b7:#6e7072:#ff6b6b:#6c9975:#e9ad0c:#2e9ea9:#c061cb:#33c7de:#b4b4b7"
    use_system_font = False
    copy_on_selection = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
