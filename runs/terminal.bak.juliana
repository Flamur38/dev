#!/usr/bin/env bash
set -e

cyan="\e[1;36m"
reset="\e[0m"
prefix="gnome-terminal"

log() {
    echo -e "\n${cyan}[${prefix}]${reset} ${cyan}$1${reset}"
}

# Detect real user (important when running with sudo)
REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"

# One profile only
JULIANA_UUID="3b7a1d5c-3c7a-4f0b-b4d0-2a1a6a6f2d11"

# ------------------------------------------
# Resolve repo paths
# ------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CONF_DIR="$REPO_ROOT/env/.config/terminal"

# ------------------------------------------
# Sanity check profile file
# ------------------------------------------
[[ -f "$CONF_DIR/juliana-profile.conf" ]] || { echo "[!] Missing $CONF_DIR/juliana-profile.conf"; exit 1; }

# ------------------------------------------
# Install packages (keep what your script needs)
# ------------------------------------------
log "Installing GNOME Terminal and dbus-x11"
sudo apt update
sudo apt install -y \
  gnome-terminal \
  dbus-x11

# ------------------------------------------
# Ensure ~/.config exists
# ------------------------------------------
log "Ensuring ~/.config exists"
sudo -u "$REAL_USER" mkdir -p "$REAL_HOME/.config"
sudo chown "$REAL_USER:$REAL_USER" "$REAL_HOME/.config"

# ------------------------------------------
# Register GNOME Terminal profile (single)
# ------------------------------------------
log "Registering GNOME Terminal profile (Juliana)"
sudo -u "$REAL_USER" \
  HOME="$REAL_HOME" USER="$REAL_USER" \
  dbus-launch dconf write \
  /org/gnome/terminal/legacy/profiles:/list \
  "[ '$JULIANA_UUID' ]"

# ------------------------------------------
# Set default profile (Juliana)
# ------------------------------------------
log "Setting Juliana as default profile"
sudo -u "$REAL_USER" \
  HOME="$REAL_HOME" USER="$REAL_USER" \
  dbus-launch dconf write \
  /org/gnome/terminal/legacy/profiles:/default \
  "'$JULIANA_UUID'"

# ------------------------------------------
# Load profile config
# ------------------------------------------
log "Loading Juliana profile"
sudo -u "$REAL_USER" \
  HOME="$REAL_HOME" USER="$REAL_USER" \
  dbus-launch dconf load \
  "/org/gnome/terminal/legacy/profiles:/:$JULIANA_UUID/" \
  < "$CONF_DIR/juliana-profile.conf"

# ------------------------------------------
# Force font (optional, but keeps it consistent)
# ------------------------------------------
log "Setting terminal font (Hack 18)"
sudo -u "$REAL_USER" \
  HOME="$REAL_HOME" USER="$REAL_USER" \
  dbus-launch dconf write \
  "/org/gnome/terminal/legacy/profiles:/:$JULIANA_UUID/font" \
  "'Hack 18'"

sudo -u "$REAL_USER" \
  HOME="$REAL_HOME" USER="$REAL_USER" \
  dbus-launch dconf write \
  "/org/gnome/terminal/legacy/profiles:/:$JULIANA_UUID/use-system-font" \
  "false"

log "GNOME Terminal setup completed"
echo -e "\e[1;32m[terminal] DONE\e[0m"

