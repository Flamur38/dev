/* ==========================================================
 * ROFI — SOC / IR MINIMAL THEME
 * Matches terminal, tmux, PS1
 * ========================================================== */

* {
    bg:            #0B1220;   /* window background */
    bg-alt:        #111827;   /* list rows (still dark!) */

    fg:            #E6EDF3;   /* main text */
    fg-muted:      #C0CAF5;   /* list item text */

    selection:     #38BDF8;
    border:        #1F2933;
    alert:         #EF4444;

    font: "JetBrains Mono 30";
}

/* ----------------------------------------------------------
 * Window
 * ---------------------------------------------------------- */
window {
    width: 40%;
    padding: 20px;
    border: 2px;
    border-color: @border;
    background-color: @bg;
    location: center;
}

/* ----------------------------------------------------------
 * Input bar
 * ---------------------------------------------------------- */
inputbar {
    padding: 8px 10px;
    spacing: 10px;
    background-color: @bg-alt;
    border-radius: 4px;
}

prompt {
    text-color: @fg-muted;
}

entry {
    text-color: @fg;
}

/* ----------------------------------------------------------
 * List view
 * ---------------------------------------------------------- */
listview {
    lines: 8;
    spacing: 6px;
    padding: 10px 0px;
    background-color: @bg;
}

/* ----------------------------------------------------------
 * Elements — dark, uniform, no zebra
 * ---------------------------------------------------------- */
element,
element normal,
element alternate,
element active,
element urgent {
    background-color: @bg-alt;
    text-color: @fg-muted;
    padding: 6px 10px;
    border-radius: 4px;
}

element selected,
element selected.normal,
element selected.alternate {
    background-color: @selection;
    text-color: @bg;
}

element urgent.selected {
    background-color: @selection;
    text-color: @bg;
}

/* ----------------------------------------------------------
 * Message / error
 * ---------------------------------------------------------- */
message {
    background-color: @bg-alt;
    padding: 10px;
}

textbox {
    text-color: @alert;
}

