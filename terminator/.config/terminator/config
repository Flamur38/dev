[global_config]
[keybindings]
[profiles]
  [[default]]
    visible_bell = True
    icon_bell = False
    cursor_fg_color = "#000000"
    cursor_bg_color = "#e0def4"
    cursor_color_default = False
    font = JetBrainsMono Nerd Font 20
    foreground_color = "#e0def4"
    show_titlebar = False
    palette = "#26233a:#eb6f92:#31748f:#f6c177:#9ccfd8:#c4a7e7:#ea9a97:#e0def4:#6e6a86:#eb6f92:#31748f:#f6c177:#9ccfd8:#c4a7e7:#ea9a97:#e0def4"
    use_system_font = False
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
[plugins]
